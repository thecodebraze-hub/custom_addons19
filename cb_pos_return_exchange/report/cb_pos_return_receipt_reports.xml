    <!-- Return receipts -->
    <record id="action_report_cb_return_receipt_58" model="ir.actions.report">
        <field name="name">Return Receipt (58mm)</field>
        <field name="model">cb.pos.return</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cb_pos_return_exchange.report_cb_return_receipt_58</field>
        <field name="report_file">cb_pos_return_exchange.report_cb_return_receipt_58</field>
        <field name="paperformat_id" ref="paperformat_cb_pos_receipt_58"/>
        <field name="print_report_name">'Return_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_cb_pos_return"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('group_cb_pos_cashier'))]"/>
    </record>

