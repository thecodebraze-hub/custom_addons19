<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Privilege: groups appear under Point of Sale in user access rights -->
    <record id="res_groups_privilege_pos_return_exchange" model="res.groups.privilege">
        <field name="name">POS Return &amp; Exchange</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
    </record>

    <!-- ── Feature groups (granular permissions for views / business logic) ── -->

    <record id="group_cb_pos_create_return" model="res.groups">
        <field name="name">Create Return</field>
        <field name="comment">Create and process POS return documents.</field>
    </record>

    <record id="group_cb_pos_redeem_voucher" model="res.groups">
        <field name="name">Redeem Voucher</field>
        <field name="comment">Redeem return vouchers at the Point of Sale.</field>
    </record>

    <record id="group_cb_pos_print_voucher" model="res.groups">
        <field name="name">Print Voucher</field>
        <field name="comment">Print return vouchers for customers.</field>
    </record>

    <record id="group_cb_pos_cancel_voucher" model="res.groups">
        <field name="name">Cancel Voucher</field>
        <field name="comment">Cancel issued return vouchers.</field>
    </record>

    <record id="group_cb_pos_view_reports" model="res.groups">
        <field name="name">View Return &amp; Exchange Reports</field>
        <field name="comment">Access return, exchange, and voucher reporting.</field>
    </record>

    <record id="group_cb_pos_cash_refund" model="res.groups">
        <field name="name">Cash Refund</field>
        <field name="comment">Settle returns with cash refunds.</field>
    </record>

    <record id="group_cb_pos_modify_settings" model="res.groups">
        <field name="name">Modify Return &amp; Exchange Settings</field>
        <field name="comment">Configure return, exchange, and voucher settings.</field>
    </record>

    <!-- ── Role groups ── -->

    <record id="group_cb_pos_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_return_exchange"/>
        <field name="comment">
            POS cashier: create returns, redeem vouchers, and print vouchers.
        </field>
        <field name="implied_ids" eval="[
            (4, ref('group_cb_pos_create_return')),
            (4, ref('group_cb_pos_redeem_voucher')),
            (4, ref('group_cb_pos_print_voucher')),
            (4, ref('point_of_sale.group_pos_user')),
        ]"/>
    </record>

    <record id="group_cb_pos_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_return_exchange"/>
        <field name="comment">
            POS manager: all cashier rights plus cancel voucher, reports,
            cash refund, and settings.
        </field>
        <field name="implied_ids" eval="[
            (4, ref('group_cb_pos_cashier')),
            (4, ref('group_cb_pos_cancel_voucher')),
            (4, ref('group_cb_pos_view_reports')),
            (4, ref('group_cb_pos_cash_refund')),
            (4, ref('group_cb_pos_modify_settings')),
            (4, ref('point_of_sale.group_pos_manager')),
        ]"/>
    </record>

    <record id="group_cb_pos_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_return_exchange"/>
        <field name="comment">
            Full return and exchange administration including record deletion
            and configuration.
        </field>
        <field name="implied_ids" eval="[(4, ref('group_cb_pos_manager'))]"/>
        <field name="user_ids" eval="[
            (4, ref('base.user_root')),
            (4, ref('base.user_admin')),
        ]"/>
    </record>

</odoo>
