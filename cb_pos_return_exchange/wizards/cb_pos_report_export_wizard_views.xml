<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cb_pos_report_export_wizard_form" model="ir.ui.view">
        <field name="name">cb.pos.report.export.wizard.form</field>
        <field name="model">cb.pos.report.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Report">
                <group>
                    <field name="export_format" widget="radio"/>
                </group>
                <footer>
                    <button name="action_export" string="Export" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
