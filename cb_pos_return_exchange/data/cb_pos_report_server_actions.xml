<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Return report exports -->
    <record id="action_export_excel_cb_pos_return" model="ir.actions.server">
        <field name="name">Export Excel</field>
        <field name="model_id" ref="model_cb_pos_return"/>
        <field name="binding_model_id" ref="model_cb_pos_return"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('group_cb_pos_view_reports'))]"/>
        <field name="state">code</field>
        <field name="code">
action = env['cb.pos.report.export'].with_context(env.context).action_export_from_context('xlsx')
        </field>
    </record>

    <record id="action_export_pdf_cb_pos_return" model="ir.actions.server">
