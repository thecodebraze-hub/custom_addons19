        <field name="group_ids" eval="[(4, ref('group_cb_pos_view_reports'))]"/>
        <field name="state">code</field>
        <field name="code">
action = env.ref('cb_pos_return_exchange.action_report_cb_pos_return_list_pdf').report_action(records)
