<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="cb_pos_return_exchange.PaymentVouchersPanel">
        <section class="cb-payment-vouchers card border-0 shadow-sm mb-2"
            t-if="hasVouchers or props.customerBalance">
            <div class="card-body py-2 px-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold text-primary">
                        <i class="fa fa-ticket me-1"/> Vouchers
                    </span>
                    <div class="text-end small" t-if="props.customerBalance">
                        <span class="text-muted">Customer Balance</span>
                        <div class="fw-semibold" t-esc="format(props.customerBalance)"/>
                    </div>
                </div>

                <div t-if="hasVouchers" class="table-responsive">
                    <table class="table table-sm table-borderless align-middle mb-0">
                        <thead class="small text-muted">
                            <tr>
                                <th>Voucher</th>
                                <th class="text-end">Applied</th>
                                <th class="text-end">Remaining</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="props.vouchers" t-as="voucher" t-key="voucher.uuid">
                                <td>
                                    <div class="fw-semibold" t-esc="voucher.name"/>
                                    <div class="small text-muted" t-esc="voucher.barcode"/>
                                </td>
                                <td class="text-end fw-semibold text-success" t-esc="format(voucher.amount)"/>
                                <td class="text-end" t-esc="format(voucher.voucher_remaining)"/>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                        t-on-click="() => this.removeVoucher(voucher)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="border-top">
                                <td class="fw-semibold">Total</td>
                                <td class="text-end fw-bold" t-esc="format(totalApplied())"/>
                                <td colspan="2"/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </section>
    </t>

</templates>
