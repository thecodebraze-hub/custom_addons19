<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sample customers -->
        <record id="demo_partner_alice" model="res.partner">
            <field name="name">Alice Martin</field>
            <field name="email">alice.martin@example.com</field>
            <field name="phone">+1 555-0101</field>
            <field name="street">12 Oak Street</field>
            <field name="city">Portland</field>
            <field name="zip">97201</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <record id="demo_partner_bob" model="res.partner">
            <field name="name">Bob Chen</field>
            <field name="email">bob.chen@example.com</field>
            <field name="phone">+1 555-0102</field>
            <field name="street">48 Maple Avenue</field>
            <field name="city">Seattle</field>
            <field name="zip">98101</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <record id="demo_partner_carol" model="res.partner">
            <field name="name">Carol Rivera</field>
            <field name="email">carol.rivera@example.com</field>
            <field name="phone">+1 555-0103</field>
            <field name="street">90 Pine Road</field>
            <field name="city">Denver</field>
            <field name="zip">80202</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <!-- Sample product category -->
        <record id="demo_product_category_retail" model="product.category">
            <field name="name">Return Demo Apparel</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <!-- Sample products -->
        <record id="demo_product_tee" model="product.product">
            <field name="name">Demo Cotton T-Shirt</field>
            <field name="default_code">CB-TEE-001</field>
            <field name="barcode">CBRETTEE001</field>
            <field name="categ_id" ref="demo_product_category_retail"/>
            <field name="list_price">25.00</field>
            <field name="standard_price">10.00</field>
            <field name="available_in_pos" eval="True"/>
            <field name="is_storable" eval="True"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>

        <record id="demo_product_jeans" model="product.product">
            <field name="name">Demo Slim Jeans</field>
            <field name="default_code">CB-JNS-001</field>
            <field name="barcode">CBRETJNS001</field>
            <field name="categ_id" ref="demo_product_category_retail"/>
            <field name="list_price">59.00</field>
            <field name="standard_price">28.00</field>
            <field name="available_in_pos" eval="True"/>
            <field name="is_storable" eval="True"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>

        <record id="demo_product_sneakers" model="product.product">
            <field name="name">Demo Running Sneakers</field>
            <field name="default_code">CB-SNK-001</field>
            <field name="barcode">CBRETSNK001</field>
            <field name="categ_id" ref="demo_product_category_retail"/>
            <field name="list_price">89.00</field>
            <field name="standard_price">42.00</field>
            <field name="available_in_pos" eval="True"/>
            <field name="is_storable" eval="True"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>

        <!-- Transactions: orders, returns, vouchers, exchanges -->
        <function model="cb.pos.return.demo" name="load_demo_data"/>

    </data>
</odoo>
