<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cb_pos_return_dashboard_form" model="ir.ui.view">
        <field name="name">cb.pos.return.dashboard.form</field>
        <field name="model">cb.pos.return.dashboard</field>
        <field name="arch" type="xml">
            <form string="Return &amp; Exchange Dashboard" create="0" delete="0">
                <header>
                    <button name="action_apply_filters" type="object" string="Refresh" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date_preset"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="config_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_returns" type="object" class="oe_stat_button" icon="fa-undo">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="returns_count"/></span>
                                <span class="o_stat_text">Returns</span>
                            </div>
                        </button>
                        <button name="action_open_returns" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="returns_amount" widget="monetary"/></span>
                                <span class="o_stat_text">Refund Value</span>
                            </div>
                        </button>
                        <button name="action_open_sales_vs_return" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="sales_amount" widget="monetary"/></span>
                                <span class="o_stat_text">Sales</span>
                            </div>
                        </button>
                        <button name="action_open_sales_vs_return" type="object" class="oe_stat_button" icon="fa-percent">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="return_pct"/>%</span>
                                <span class="o_stat_text">Return Rate</span>
                            </div>
                        </button>
                        <button name="action_open_vouchers" type="object" class="oe_stat_button" icon="fa-ticket">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="vouchers_outstanding" widget="monetary"/></span>
                                <span class="o_stat_text">Voucher Liability</span>
                            </div>
                        </button>
                        <button name="action_open_vouchers" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="vouchers_issued" widget="monetary"/></span>
                                <span class="o_stat_text">Vouchers Issued</span>
                            </div>
                        </button>
                        <button name="action_open_vouchers" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="vouchers_redeemed" widget="monetary"/></span>
                                <span class="o_stat_text">Vouchers Redeemed</span>
                            </div>
                        </button>
                        <button name="action_open_exchanges" type="object" class="oe_stat_button" icon="fa-exchange">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="exchanges_count"/></span>
                                <span class="o_stat_text">Exchanges</span>
                            </div>
                        </button>
                    </div>
                    <group string="Key Performance Indicators">
                        <group>
                            <field name="avg_return_value" widget="monetary"/>
                            <field name="pending_returns"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Return Trend" name="return_trend">
                            <field name="line_ids" domain="[('chart_type','=','return_trend')]" readonly="1">
                                <list>
                                    <field name="label"/>
                                    <field name="count_value"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Voucher Liability" name="voucher_liability">
                            <field name="line_ids" domain="[('chart_type','=','voucher_liability')]" readonly="1">
                                <list>
                                    <field name="label"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sales vs Return" name="sales_vs_return">
                            <field name="line_ids" domain="[('chart_type','=','sales_vs_return')]" readonly="1">
                                <list>
                                    <field name="label"/>
                                    <field name="amount" sum="Returns"/>
                                </list>
                            </field>
                        </page>
                        <page string="Top Branches" name="top_branches">
                            <field name="line_ids" domain="[('chart_type','=','top_branch')]" readonly="1">
                                <list>
                                    <field name="label"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Top Cashiers" name="top_cashiers">
                            <field name="line_ids" domain="[('chart_type','=','top_cashier')]" readonly="1">
                                <list>
                                    <field name="label"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Top Customers" name="top_customers">
                            <field name="line_ids" domain="[('chart_type','=','top_customer')]" readonly="1">
                                <list>
                                    <field name="label"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cb_pos_return_dashboard_server" model="ir.actions.server">
        <field name="name">Return &amp; Exchange Dashboard</field>
        <field name="model_id" ref="model_cb_pos_return_dashboard"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_dashboard()
        </field>
    </record>

</odoo>
