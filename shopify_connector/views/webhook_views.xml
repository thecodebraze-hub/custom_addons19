<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="shopify_webhook_view_list" model="ir.ui.view">
        <field name="name">shopify.webhook.list</field>
        <field name="model">shopify.webhook</field>
        <field name="arch" type="xml">
            <list string="Shopify Webhooks">
                <field name="name"/>
                <field name="instance_id"/>
                <field name="topic"/>
                <field name="webhook_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="shopify_webhook_view_form" model="ir.ui.view">
        <field name="name">shopify.webhook.form</field>
        <field name="model">shopify.webhook</field>
        <field name="arch" type="xml">
            <form string="Shopify Webhook">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Orders Create Webhook"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Webhook Configuration">
                            <field name="instance_id"/>
                            <field name="topic" placeholder="orders/create"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Shopify Registration">
                            <field name="webhook_id" readonly="1"/>
                            <field name="secret" password="True"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_webhook_view_search" model="ir.ui.view">
        <field name="name">shopify.webhook.search</field>
        <field name="model">shopify.webhook</field>
        <field name="arch" type="xml">
            <search string="Shopify Webhooks">
                <field name="name"/>
                <field name="instance_id"/>
                <field name="topic"/>
                <field name="webhook_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Store" name="group_instance" context="{'group_by': 'instance_id'}"/>
                    <filter string="Topic" name="group_topic" context="{'group_by': 'topic'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_webhook_action" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">shopify.webhook</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="shopify_webhook_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first Shopify webhook
            </p>
            <p>
                Webhook registrations will be synchronized with Shopify once integration is enabled.
            </p>
        </field>
    </record>

</odoo>
