<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="shopify_queue_view_list" model="ir.ui.view">
        <field name="name">shopify.queue.list</field>
        <field name="model">shopify.queue</field>
        <field name="arch" type="xml">
            <list string="Shopify Queue" create="false" edit="false">
                <field name="name"/>
                <field name="instance_id"/>
                <field name="job_type"/>
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'pending'"
                    decoration-warning="state == 'processing'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'failed'"
                />
                <field name="attempts"/>
                <field name="next_retry" optional="show"/>
                <field name="create_date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="shopify_queue_view_form" model="ir.ui.view">
        <field name="name">shopify.queue.form</field>
        <field name="model">shopify.queue</field>
        <field name="arch" type="xml">
            <form string="Queue Job" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="instance_id" readonly="1"/>
                            <field name="job_type" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="attempts" readonly="1"/>
                        </group>
                        <group>
                            <field name="next_retry" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_queue_view_search" model="ir.ui.view">
        <field name="name">shopify.queue.search</field>
        <field name="model">shopify.queue</field>
        <field name="arch" type="xml">
            <search string="Shopify Queue">
                <field name="name"/>
                <field name="instance_id"/>
                <field name="job_type"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Processing" name="processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter string="Store" name="group_instance" context="{'group_by': 'instance_id'}"/>
                    <filter string="Job Type" name="group_job_type" context="{'group_by': 'job_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_queue_action" model="ir.actions.act_window">
        <field name="name">Queue</field>
        <field name="res_model">shopify.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="shopify_queue_view_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No queue jobs yet
            </p>
            <p>
                Synchronization jobs will appear here once sync operations are enabled.
            </p>
        </field>
    </record>

</odoo>
