<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="module_category_shopify" model="ir.module.category">
        <field name="name">Shopify</field>
        <field name="description">Manage Shopify store integrations.</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_shopify" model="res.groups.privilege">
        <field name="name">Shopify</field>
        <field name="description">Access level for Shopify connector features.</field>
        <field name="category_id" ref="module_category_shopify"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_shopify_user" model="res.groups">
        <field name="name">Shopify User</field>
        <field name="privilege_id" ref="res_groups_privilege_shopify"/>
        <field name="sequence">10</field>
        <field name="comment">Read-only access to Shopify connector data.</field>
    </record>

    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Shopify Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_shopify"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_shopify_user'))]"/>
        <field name="comment">Full access to Shopify connector configuration and operations.</field>
    </record>

    <record id="shopify_instance_company_rule" model="ir.rule">
        <field name="name">Shopify Instance multi-company</field>
        <field name="model_id" ref="model_shopify_instance"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_log_company_rule" model="ir.rule">
        <field name="name">Shopify Log multi-company</field>
        <field name="model_id" ref="model_shopify_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_queue_company_rule" model="ir.rule">
        <field name="name">Shopify Queue multi-company</field>
        <field name="model_id" ref="model_shopify_queue"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_webhook_company_rule" model="ir.rule">
        <field name="name">Shopify Webhook multi-company</field>
        <field name="model_id" ref="model_shopify_webhook"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
