<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_cb_product_info" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cb_pos_product_info</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="margin_and_cost" position="after">
                <setting id="cb_show_product_cost"
                    string="Product Card: Show Cost"
                    help="Show the product cost inside the info icon on POS product cards">
                    <field name="pos_cb_show_product_cost"/>
                </setting>
                <setting id="cb_show_product_onhand"
                    string="Product Card: Show On-hand Qty"
                    help="Show the on-hand quantity inside the info icon on POS product cards">
                    <field name="pos_cb_show_product_onhand"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
