<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_cb_cancel_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cb_cancel_approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="price_control" position="after">
                <setting id="cb_require_cancel_approval"
                    string="Manager Approval to Cancel Order"
                    help="Require a manager PIN and reason before cancelling a POS order or removing items with Backspace">
                    <field name="pos_cb_require_cancel_approval"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
