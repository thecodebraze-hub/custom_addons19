<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cb_pos_cancel_approval_log_list" model="ir.ui.view">
        <field name="name">cb.pos.cancel.approval.log.list</field>
        <field name="model">cb.pos.cancel.approval.log</field>
        <field name="arch" type="xml">
            <list string="Cancel Approvals" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="action_type"/>
                <field name="order_reference"/>
                <field name="product_name"/>
                <field name="amount"/>
                <field name="cashier_id"/>
                <field name="manager_id"/>
                <field name="reason"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="view_cb_pos_cancel_approval_log_form" model="ir.ui.view">
        <field name="name">cb.pos.cancel.approval.log.form</field>
        <field name="model">cb.pos.cancel.approval.log</field>
        <field name="arch" type="xml">
            <form string="Cancel Approval" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="action_type"/>
                            <field name="order_reference"/>
                            <field name="product_name"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="cashier_id"/>
                            <field name="manager_id"/>
                            <field name="config_id"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cb_pos_cancel_approval_log" model="ir.actions.act_window">
        <field name="name">Cancel Approvals</field>
        <field name="res_model">cb.pos.cancel.approval.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cb_pos_cancel_approval_log"
        name="Cancel Approvals"
        parent="point_of_sale.menu_point_of_sale"
        action="action_cb_pos_cancel_approval_log"
        sequence="50"
        groups="point_of_sale.group_pos_manager"/>
</odoo>
