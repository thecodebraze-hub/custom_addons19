            <field name="list_price">1000.0</field>
            <field name="liquor_is_liquor" eval="True"/>
            <field name="liquor_bottle_size_ml">180.0</field>
        </record>

        <record id="product_gal_arrack_100ml_shot" model="product.product">
            <field name="name">Gal Arrack 100ml Shot</field>
            <field name="default_code">GAL-SHOT-100</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[Command.set([ref('cb_bar_liquor_inventory.pos_category_liquor')])]"/>
            <field name="categ_id" ref="cb_bar_liquor_inventory.product_category_liquor"/>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="list_price">600.0</field>
            <field name="liquor_is_liquor" eval="True"/>
            <field name="liquor_is_shot_product" eval="True"/>
