<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_liquor_open_bottle_list" model="ir.ui.view">
        <field name="name">liquor.open.bottle.list</field>
        <field name="model">liquor.open.bottle</field>
        <field name="arch" type="xml">
            <list string="Opened Bottles" decoration-muted="state == 'closed'">
                <field name="product_id"/>
                <field name="bottle_size_ml"/>
                <field name="remaining_ml"/>
                <field name="state"/>
                <field name="opened_date"/>
                <field name="last_updated"/>
                <field name="pos_order_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_liquor_open_bottle_form" model="ir.ui.view">
        <field name="name">liquor.open.bottle.form</field>
        <field name="model">liquor.open.bottle</field>
        <field name="arch" type="xml">
            <form string="Opened Bottle">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="bottle_size_ml"/>
                            <field name="remaining_ml"/>
                            <field name="opened_date"/>
                            <field name="last_updated"/>
                        </group>
                    </group>
                    <group string="Traceability">
                        <field name="opening_picking_id" readonly="1"/>
                        <field name="pos_order_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_liquor_open_bottle_search" model="ir.ui.view">
        <field name="name">liquor.open.bottle.search</field>
        <field name="model">liquor.open.bottle</field>
        <field name="arch" type="xml">
            <search string="Opened Bottles">
                <field name="product_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <record id="action_liquor_open_bottle" model="ir.actions.act_window">
        <field name="name">Opened Liquor Bottles</field>
        <field name="res_model">liquor.open.bottle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_liquor_open_bottle_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <menuitem
        id="menu_liquor_open_bottle"
        name="Opened Liquor Bottles"
        parent="stock.menu_stock_inventory_control"
        action="action_liquor_open_bottle"
        sequence="120"
        groups="stock.group_stock_user"/>
</odoo>
