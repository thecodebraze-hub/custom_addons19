<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cb_auto_backup_manager" model="ir.module.category">
        <field name="name">Auto Backup Manager</field>
        <field name="parent_id" ref="base.module_category_administration"/>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_cb_auto_backup_manager" model="res.groups.privilege">
        <field name="name">Auto Backup Manager</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_cb_auto_backup_manager"/>
        <field name="description">Manage automated database and filestore backups.</field>
    </record>

    <record id="group_cb_backup_operator" model="res.groups">
        <field name="name">Backup Operator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_cb_auto_backup_manager"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">View backup operations, run permitted backups, and verify archives. Cannot change configuration or secrets.</field>
    </record>

    <record id="group_cb_backup_administrator" model="res.groups">
        <field name="name">Backup Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_cb_auto_backup_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_cb_backup_operator'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to backup configuration, schedules, and history.</field>
    </record>
</odoo>
