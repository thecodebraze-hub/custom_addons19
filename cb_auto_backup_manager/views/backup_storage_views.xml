<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cb_backup_storage_list" model="ir.ui.view">
        <field name="name">cb.backup.storage.list</field>
        <field name="model">cb.backup.storage</field>
        <field name="arch" type="xml">
            <list string="Storage Destinations">
                <field name="name"/>
                <field name="type"/>
                <field name="connection_state" widget="badge"
                       decoration-success="connection_state == 'ready'"
                       decoration-danger="connection_state == 'failed'"
                       decoration-warning="connection_state in ('unsupported', 'not_tested')"
                       decoration-muted="connection_state == 'disconnected'"/>
                <field name="active"/>
                <field name="last_test_datetime"/>
                <field name="validation_status" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cb_backup_storage_form" model="ir.ui.view">
        <field name="name">cb.backup.storage.form</field>
        <field name="model">cb.backup.storage</field>
        <field name="arch" type="xml">
            <form string="Storage Destination">
                <header>
                    <button name="action_validate_storage"
                            string="Validate Storage"
                            type="object"
                            class="btn-secondary"
                            invisible="type != 'local'"
                            groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-primary"
                            invisible="type not in ('sftp', 'google_drive')"
                            groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                    <button name="action_connect_google_drive"
                            string="Connect Google Drive"
                            type="object"
                            class="btn-primary"
                            invisible="type != 'google_drive' or google_drive_connection_status == 'connected'"
                            groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                    <button name="action_disconnect_google_drive"
                            string="Disconnect"
                            type="object"
                            class="btn-secondary"
                            invisible="type != 'google_drive' or google_drive_connection_status != 'connected'"
                            groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                    <field name="validation_status" widget="statusbar"
                           statusbar_visible="unknown,valid,invalid"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Local Server Backups"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="type"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="connection_state" readonly="1"/>
                            <field name="validation_status" readonly="1"/>
                            <field name="validation_message" readonly="1"/>
                            <field name="last_test_datetime" readonly="1"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1" placeholder="Optional notes about this destination."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Local Configuration" name="local_config"
                              invisible="type != 'local'">
                            <group>
                                <field name="local_path" required="type == 'local'"/>
                            </group>
                        </page>
                        <page string="SFTP Configuration" name="sftp_config"
                              invisible="type != 'sftp'">
                            <group>
                                <group string="Connection">
                                    <field name="sftp_host" required="type == 'sftp'"/>
                                    <field name="sftp_port" required="type == 'sftp'"/>
                                    <field name="sftp_username" required="type == 'sftp'"/>
                                    <field name="sftp_authentication_type" required="type == 'sftp'"/>
                                </group>
                                <group string="Remote">
                                    <field name="sftp_remote_path" required="type == 'sftp'"
                                           placeholder="/backups/odoo"/>
                                    <field name="sftp_host_key" placeholder="SHA256:..."/>
                                </group>
                            </group>
                            <group string="Password Authentication"
                                   invisible="sftp_authentication_type != 'password'">
                                <field name="sftp_password" password="True"
                                       groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                            </group>
                            <group string="Private Key Authentication"
                                   invisible="sftp_authentication_type != 'private_key'">
                                <field name="sftp_private_key" widget="text"
                                       groups="cb_auto_backup_manager.group_cb_backup_administrator"
                                       placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"/>
                                <field name="sftp_private_key_passphrase" password="True"
                                       groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                            </group>
                            <div class="text-muted fst-italic">
                                Host key verification is required. Use Test Connection to obtain
                                the remote fingerprint, verify it out-of-band, then save it.
                                Credentials are visible only to Backup Administrators.
                            </div>
                        </page>
                        <page string="Google Drive Configuration" name="google_drive_config"
                              invisible="type != 'google_drive'">
                            <group>
                                <group string="OAuth Client">
                                    <field name="google_drive_client_id"
                                           groups="cb_auto_backup_manager.group_cb_backup_administrator"
                                           placeholder="xxxxx.apps.googleusercontent.com"/>
                                    <field name="google_drive_client_secret" password="True"
                                           groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                                    <field name="google_drive_redirect_uri"/>
                                </group>
                                <group string="Drive">
                                    <field name="google_drive_folder" placeholder="Odoo Backups"/>
                                    <field name="google_drive_folder_id" invisible="1"/>
                                    <field name="google_drive_account"/>
                                    <field name="google_drive_connection_status"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Create an OAuth client (Web application) in Google Cloud Console.
                                Enable the Google Drive API, paste the Client ID and Client Secret,
                                add the Redirect URI above to the client, save, then click
                                Connect Google Drive. Credentials are visible only to Backup Administrators.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cb_backup_storage_search" model="ir.ui.view">
        <field name="name">cb.backup.storage.search</field>
        <field name="model">cb.backup.storage</field>
        <field name="arch" type="xml">
            <search string="Storage Destinations">
                <field name="name"/>
                <field name="type"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Local" name="filter_local" domain="[('type', '=', 'local')]"/>
                <filter string="SFTP" name="filter_sftp" domain="[('type', '=', 'sftp')]"/>
                <filter string="Google Drive" name="filter_gdrive" domain="[('type', '=', 'google_drive')]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cb_backup_storage" model="ir.actions.act_window">
        <field name="name">Storage Destinations</field>
        <field name="res_model">cb.backup.storage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cb_backup_storage_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first storage destination
            </p>
            <p>
                Configure where verified backup ZIP files are stored.
            </p>
        </field>
    </record>
</odoo>
