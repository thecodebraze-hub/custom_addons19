<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cb_backup_settings_form" model="ir.ui.view">
        <field name="name">cb.backup.settings.form</field>
        <field name="model">cb.backup.settings</field>
        <field name="arch" type="xml">
            <form string="Settings" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Auto Backup Manager Settings</h1>
                    </div>
                    <group>
                        <div class="text-muted">
                            Backup plans, schedules, storage destinations, and notification
                            recipients are configured from the Auto Backup Manager menus.
                            There are no global credentials on this page.
                        </div>
                    </group>
                    <group>
                        <button name="action_open_dashboard" type="object"
                                string="Dashboard" class="btn-primary"/>
                        <button name="action_open_plans" type="object"
                                string="Backup Plans" class="btn-secondary"/>
                        <button name="action_open_storage" type="object"
                                string="Storage Destinations" class="btn-secondary"/>
                        <button name="action_open_encryption" type="object"
                                string="Encryption Profiles" class="btn-secondary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cb_backup_settings" model="ir.actions.server">
        <field name="name">Settings</field>
        <field name="model_id" ref="model_cb_backup_settings"/>
        <field name="state">code</field>
        <field name="code">action = env['cb.backup.settings'].action_open_settings()</field>
    </record>
</odoo>
