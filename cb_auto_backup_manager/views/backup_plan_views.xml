<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cb_backup_plan_list" model="ir.ui.view">
        <field name="name">cb.backup.plan.list</field>
        <field name="model">cb.backup.plan</field>
        <field name="arch" type="xml">
            <list string="Backup Plans">
                <field name="name" string="Plan"/>
                <field name="database_name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'inactive'"
                       decoration-info="state == 'draft'"/>
                <field name="backups_per_day"/>
                <field name="retention_days" string="Retention"/>
                <field name="last_backup_datetime" string="Last Backup"/>
                <field name="next_backup_datetime" string="Next Backup"/>
                <field name="storage_destination_ids" widget="many2many_tags"/>
                <field name="encryption_enabled" optional="show"/>
                <field name="timezone" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_cb_backup_plan_form" model="ir.ui.view">
        <field name="name">cb.backup.plan.form</field>
        <field name="model">cb.backup.plan</field>
        <field name="arch" type="xml">
            <form string="Backup Plan">
                <header>
                    <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'active'"
                            groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                    <button name="action_deactivate"
                            string="Deactivate"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'active'"
                            groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                    <button name="action_backup_now"
                            string="Backup Now"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'active'"
                            groups="cb_auto_backup_manager.group_cb_backup_operator,cb_auto_backup_manager.group_cb_backup_administrator"/>
                    <button name="action_cleanup_now"
                            string="Cleanup Now"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'active'"
                            groups="cb_auto_backup_manager.group_cb_backup_administrator"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,inactive"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Daily Production Backup"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="database_name"
                                   widget="selection"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="timezone"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Retention">
                            <field name="compression_format"/>
                            <field name="retention_days"/>
                        </group>
                    </group>
                    <group string="Encryption">
                        <group>
                            <field name="encryption_enabled"/>
                            <field name="encryption_method" invisible="not encryption_enabled"/>
                            <field name="encryption_profile_id"
                                   invisible="not encryption_enabled"
                                   required="encryption_enabled"
                                   options="{'no_create_edit': False}"
                                   domain="[('active', '=', True)]"/>
                        </group>
                        <group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not encryption_enabled">
                                <field name="encryption_warning" nolabel="1"/>
                            </div>
                        </group>
                    </group>
                    <group string="Storage Destinations">
                        <field name="storage_destination_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': False}"
                               domain="[('active', '=', True)]"/>
                    </group>
                    <group string="Automatic Backup Schedule">
                        <group>
                            <field name="backups_per_day"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                Automatic backups run this many times on each scheduled day.
                                Manual Backup Now is independent of this value.
                            </div>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not schedule_match_warning">
                        <field name="schedule_match_warning" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Backup Times" name="schedules">
                            <field name="schedule_ids" nolabel="1"
                                   context="{'default_plan_id': id, 'default_frequency': 'daily'}">
                                <list editable="bottom" default_order="frequency, time_hour, time_minute, id">
                                    <field name="line_number" optional="hide"/>
                                    <field name="frequency"/>
                                    <field name="weekday"
                                           required="frequency == 'weekly'"
                                           invisible="frequency != 'weekly'"
                                           optional="show"/>
                                    <field name="month_day"
                                           required="frequency == 'monthly'"
                                           invisible="frequency != 'monthly'"
                                           optional="show"/>
                                    <field name="time_display" string="Time"/>
                                    <field name="time_hour" optional="hide"/>
                                    <field name="time_minute" optional="hide"/>
                                    <field name="last_run_datetime" optional="hide"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <div class="text-muted fst-italic">
                                Add one line for each automatic backup time. Daily plans must have
                                exactly as many active times as Backups Per Day. Weekly and monthly
                                lines keep their weekday or month-day, and each selected day must
                                also have that many times. Times are shown in chronological order.
                                Lowering Backups Per Day does not delete times automatically.
                            </div>
                        </page>
                        <page string="Notifications" name="notifications">
                            <group>
                                <group string="Events">
                                    <field name="notify_on_success"/>
                                    <field name="notify_on_failure"/>
                                    <field name="notify_on_partial"/>
                                    <field name="notify_on_cleanup_failure"/>
                                </group>
                                <group string="Recipients">
                                    <field name="notification_user_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           placeholder="Select users to notify"/>
                                    <div class="text-muted">
                                        Scheduled backups send Discuss/inbox notifications.
                                        Manual Backup Now, Cleanup Now, and Test Connection
                                        also show an immediate on-screen notification.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Backup Information" name="backup_info">
                            <group>
                                <field name="last_backup_datetime"/>
                                <field name="next_backup_datetime"/>
                                <field name="last_cleanup_datetime"/>
                            </group>
                        </page>
                        <page string="Cleanup Logs" name="cleanup_logs">
                            <field name="cleanup_log_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="cleanup_datetime"/>
                                    <field name="storage_id"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-warning="status == 'partial'"
                                           decoration-danger="status == 'failed'"/>
                                    <field name="files_scanned"/>
                                    <field name="files_deleted"/>
                                    <field name="files_skipped"/>
                                    <field name="bytes_deleted"/>
                                </list>
                            </field>
                        </page>
                        <page string="History" name="history">
                            <field name="history_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="backup_datetime"/>
                                    <field name="trigger_type"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-warning="status == 'partial'"
                                           decoration-danger="status == 'failed'"
                                           decoration-info="status == 'running'"/>
                                    <field name="file_name"/>
                                    <field name="file_size"/>
                                    <field name="duration_seconds"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cb_backup_plan_search" model="ir.ui.view">
        <field name="name">cb.backup.plan.search</field>
        <field name="model">cb.backup.plan</field>
        <field name="arch" type="xml">
            <search string="Backup Plans">
                <field name="name"/>
                <field name="database_name"/>
                <field name="storage_destination_ids"/>
                <filter string="Active Plans" name="filter_active_state"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Inactive" name="filter_inactive_state"
                        domain="[('state', '=', 'inactive')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Database" name="group_database"
                            context="{'group_by': 'database_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cb_backup_plan" model="ir.actions.act_window">
        <field name="name">Backup Plans</field>
        <field name="res_model">cb.backup.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cb_backup_plan_search"/>
        <field name="context">{'search_default_filter_active_state': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first backup plan
            </p>
            <p>
                Define which database to back up, where to store files,
                and when backups should run.
            </p>
        </field>
    </record>
</odoo>
