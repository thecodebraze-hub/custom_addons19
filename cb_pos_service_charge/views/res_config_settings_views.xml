<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cb_pos_service_charge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_restaurant.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="iface_printbill" position="after">
                <setting
                    string="Service Charge"
                    help="Add a percentage-based service charge to POS orders from Actions → % Service Charge."
                    id="iface_service_charge"
                    invisible="not pos_module_pos_restaurant or is_kiosk_mode">
                    <field name="pos_iface_service_charge"/>
                    <div class="content-group mt16" invisible="not pos_iface_service_charge">
                        <label for="pos_service_charge_id" class="o_light_label"/>
                        <field name="pos_service_charge_id" options="{'no_create_edit': True}"/>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
