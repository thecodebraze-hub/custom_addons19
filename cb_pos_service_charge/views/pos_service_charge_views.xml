<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cb_pos_service_charge_view_list" model="ir.ui.view">
        <field name="name">pos.service.charge.list</field>
        <field name="model">pos.service.charge</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rate"/>
                <field name="product_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="cb_pos_service_charge_view_form" model="ir.ui.view">
        <field name="name">pos.service.charge.form</field>
        <field name="model">pos.service.charge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rate"/>
                        <field name="product_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cb_pos_service_charge" model="ir.actions.act_window">
        <field name="name">Service Charges</field>
        <field name="res_model">pos.service.charge</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_cb_pos_service_charge"
        name="Service Charges"
        parent="point_of_sale.menu_point_config_product"
        action="action_cb_pos_service_charge"
        sequence="45"/>
</odoo>
