<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="cb_pos_service_charge.OrderDisplay" t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]//div[hasclass('fs-3')]" position="before">
            <div
                t-if="order.hasServiceCharge"
                class="service-charge-summary subentry d-flex justify-content-between w-100 fs-6 text-muted">
                <span t-esc="order.serviceChargeLabel"/>
                <span t-esc="order.currencyServiceChargeAmount" class="service-charge-amount"/>
            </div>
        </xpath>
    </t>

</templates>
