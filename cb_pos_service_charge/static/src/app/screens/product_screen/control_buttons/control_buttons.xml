<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="cb_pos_service_charge.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]/NoteButton" position="before">
            <button
                t-if="showServiceChargeButton"
                t-att-class="buttonClass"
                t-on-click="() => this.clickServiceCharge()">
                <i class="fa fa-percent me-1" role="img" aria-label="Service Charge" title="Service Charge"/>
                <t t-esc="serviceChargeLabel"/>
            </button>
        </xpath>
    </t>

</templates>
